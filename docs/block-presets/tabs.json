{
  "definitions": [
    {
      "id": "tabs",
      "title": "Tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tabs",
              "model": "tabs",
              "filter": "tabs"
            }
          }
        }
      }
    },
    {
      "title": "Tabs Item",
      "id": "tabs-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Tabs Item",
              "model": "tabs-item",
              "filter": "tabs-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tabs",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Tabs Style",
          "options": [
            {
              "name": "Layout",
              "children": [
                {
                  "name": "Horizontal",
                  "value": "horizontal"
                },
                {
                  "name": "Vertical",
                  "value": "vertical"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "tabs-item",
      "fields": [
        {
          "component": "text",
          "name": "label",
          "label": "Tab Label",
          "valueType": "string",
          "required": true
        },
        {
          "component": "richtext",
          "name": "content",
          "label": "Tab Content",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tabs",
      "components": [
        "tabs-item"
      ]
    },
    {
      "id": "tabs-item",
      "rte": {
        "toolbar": {
          "blocks": [
            "paragraph",
            "h3"
          ],
          "insert": [
            "table",
            "link",
            "unlink"
          ]
        },
        "actions": {
          "table": {
            "label": "Insert Table",
            "wrapInParagraphs": true
          },
          "link": {
            "label": "Insert Link",
            "shortcut": "Mod-K",
            "hideTarget": false
          },
          "unlink": {
            "label": "Remove Link",
            "shortcut": "Mod-Shift-K"
          }
        }
      }
    }
  ]
