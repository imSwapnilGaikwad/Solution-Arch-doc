{
  "definitions": [
    {
      "id": "faq",
      "title": "FAQ",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "FAQ",
              "model": "faq",
              "filter": "faq"
            }
          }
        }
      }
    },
    {
      "title": "FAQ Item",
      "id": "faq-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "FAQ Item",
              "model": "faq-item",
              "filter": "faq-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "faq",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "FAQ Options",
          "options": [
            {
              "name": "SEO & Schema",
              "children": [
                {
                  "name": "Enable FAQ Schema",
                  "value": "seo-schema-enable"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "faq-item",
      "fields": [
        {
          "component": "text",
          "name": "question",
          "label": "Question",
          "valueType": "string",
          "required": true
        },
        {
          "component": "richtext",
          "name": "answer",
          "label": "Answer",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "faq",
      "components": [
        "faq-item"
      ]
    },
    {
      "id": "faq-item",
      "rte": {
        "toolbar": {
          "blocks": [
            "paragraph"
          ],
          "insert": [
            "link",
            "unlink"
          ]
        },
        "actions": {
          "link": {
            "label": "Insert Link",
            "shortcut": "Mod-K",
            "hideTarget": false
          },
          "unlink": {
            "label": "Remove Link",
            "shortcut": "Mod-Shift-K"
          }
        }
      }
    }
  ]
}
